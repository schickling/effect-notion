# Genie-generated files - collapse in GitHub PR diffs
# These files are generated from *.genie.ts sources
package.json linguist-generated=true
**/package.json linguist-generated=true
tsconfig.json linguist-generated=true
**/tsconfig.json linguist-generated=true
tsconfig.*.json linguist-generated=true
.github/workflows/*.yml linguist-generated=true
.oxlintrc.json linguist-generated=true
.oxfmtrc.json linguist-generated=true
.github/labels.json linguist-generated=true
.github/repo-settings.json linguist-generated=true
pnpm-workspace.yaml linguist-generated=true
pnpm-install-contract.json linguist-generated=true
*.gen.* linguist-generated=true

# Weaver semconv registry - generated from genie/weaver-registry/*.genie.ts
# (exact paths so the hand-authored *.genie.ts sources and registry.ts stay visible)
genie/weaver-registry/*.yaml linguist-generated=true
genie/weaver-registry/constants.ts linguist-generated=true
genie/weaver-registry/constants.rs linguist-generated=true

# Generated CI scripts are projections of adjacent TypeScript sources. Keep
# handwritten bootstrap and regression scripts review-visible.
genie/ci-scripts/nix-gc-race-retry.sh linguist-generated=true
genie/ci-scripts/prepare-job-local-rust-state.sh linguist-generated=true
genie/ci-scripts/resolve-devenv.sh linguist-generated=true
genie/ci-scripts/run-with-nix-gc-race-retry.sh linguist-generated=true

# Tracked Buck product modules are content-addressed generated artifacts. Their
# embedded documentation can contain semantic Markdown trailing spaces.
nix/buck2-products/*/*.js linguist-generated=true -whitespace
nix/buck2-products/*/product.json linguist-generated=true

# Lock files - collapse in GitHub PR diffs
*.lock linguist-generated=true
**/*.lock linguist-generated=true
*.lockb linguist-generated=true
**/*.lockb linguist-generated=true
pnpm-lock.yaml linguist-generated=true
**/pnpm-lock.yaml linguist-generated=true

# The root Cargo lock is selected dependency topology and must stay visible.
rust/Cargo.lock -linguist-generated
