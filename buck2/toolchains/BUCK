# `go_bootstrap` is the `go build` driver every
# `buck2/go/defs.bzl:go_vendored_binary` action uses. Prelude's per-package
# compile/link graph (`GoToolchainInfo`) is deliberately not declared: it needs
# GOROOT as a Buck `Artifact` (`prelude//go:go_stdlib.bzl`), which for a Nix
# realization means an action-language helper decision 0028 does not admit and a
# 250 MB copy per configuration. See decision 0029.
nix_go_bootstrap_toolchain(
    name = "go_bootstrap",
    capabilities = CAPABILITIES,
    generation = GENERATION,
    visibility = ["PUBLIC"],
)

bun_toolchain(
    name = "bun",
    capabilities = CAPABILITIES,
    generation = GENERATION,
    visibility = ["PUBLIC"],
)

# TypeScript vertical-slice toolchain. Bun and effect-tsgo come from the same
# `.buck2/capabilities` projection the Rust and support tools use, so both are
# exact executables from the Nix realizations of this run rather than
# hand-maintained pins that go stale on the next nixpkgs bump. The selected pair
# is immutable and identical across worktrees on the same host platform, so both
# commands are represented in the action-key identity (EXEC-R02).
effect_tsgo_toolchain(
    name = "effect_tsgo",
    capabilities = CAPABILITIES,
    generation = GENERATION,
    runner = "//:packages/@overeng/buck2-tools/src/typescript-runner.ts",
    visibility = ["PUBLIC"],
)

# Platform-native containment for TypeScript actions. `active_platforms` names execution
# platforms whose containment gate has passed against the *current* generated capability
# projection. Every other platform resolves to `none` and keeps complete-input mutation hashing.
#
# Linux uses the projected `sandbox-bubblewrap` launcher and its exact per-architecture closure.
# Darwin uses the fixed system Seatbelt launcher and is admitted only for kernel major 25. The
# containment gate in `//buck2/sandbox-gate/...` must pass whenever a Linux projection changes
# and must be re-run for every Darwin OS upgrade. Seatbelt's public interface is deprecated, so
# an unproven kernel fails closed in the runner rather than silently weakening containment.
sandbox_toolchain(
    name = "typescript_sandbox",
    active_platforms = ["x86_64-linux", "aarch64-linux", "aarch64-macos"],
    capabilities = CAPABILITIES,
    darwin_kernel_majors = ["25"],
    generation = GENERATION,
    visibility = ["PUBLIC"],
)

sandbox_platform_key_validation_test(
    name = "sandbox_platform_key_validation_unit_test",
)

# The deliberate host-service executor. It is not a weaker sandbox: it is the explicit absence of
# one, reachable only from a test lane that declares `execution_mode = "unsandboxed-local"`
# together with a host-service capability (`network`, `loopback`, `nix-daemon`, `pty`) and
# `cacheable = False`. Anything else keeps `:typescript_sandbox`.
unsandboxed_local_toolchain(
    name = "unsandboxed_local_executor",
    visibility = ["PUBLIC"],
)

# Analysis-only fixture: the rule and platform live in the hub cell and must
# consume the exact same ProductPlatformInfo identity.
configured_rust_toolchain(
    name = "cross_cell_provider_identity",
    archiver = ":archive_tool",
    compile_env = {},
    compiler = ":archive_tool",
    identity = "cross-cell-provider-identity/v1",
    linker = ":archive_tool",
    target_platform = host_platform_label(),
    target_triple = host_rust_target_triple(),
    visibility = ["PUBLIC"],
)

cross_cell_product_identity(
    name = "cross_cell_product_identity",
    target_platform = host_platform_label(),
    visibility = ["PUBLIC"],
)

