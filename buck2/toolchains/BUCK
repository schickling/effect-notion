# The same `effect-tsgo` realization `effect_tsgo_toolchain` compiles with, for suites whose
# assertion *is* a TypeScript proof over their own sources; a test may not resolve `tsgo` from
# PATH, and the sandbox binds this capability's whole closure.
support_tool(
    name = "tool_effect_tsgo",
    protocol = "effect-utils/buck2-effect-tsgo/v1",
    tool_id = "effect-tsgo",
    visibility = ["PUBLIC"],
)

