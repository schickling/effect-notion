{
  "version": "2.0.0",
  "tasks": [
    // ============================================================
    // install
    // ============================================================
    {
      "label": "install",
      "type": "shell",
      "command": "devenv tasks run pnpm:install",
      "problemMatcher": [],
      "presentation": {
        "focus": true,
        "panel": "shared",
        "group": "install",
        "showReuseMessage": false,
        "clear": false,
        "close": true
      }
    },

    // ============================================================
    // ts
    // ============================================================
    {
      "label": "ts",
      "type": "shell",
      "command": "devenv tasks run ts:check",
      "problemMatcher": ["$tsc"],
      "presentation": {
        "focus": false,
        "panel": "shared",
        "group": "ts",
        "showReuseMessage": false,
        "clear": false
      }
    },
    {
      "label": "ts:build-watch",
      "type": "shell",
      "command": "devenv tasks run ts:build-watch",
      "problemMatcher": ["$tsc-watch"],
      "isBackground": true,
      "presentation": {
        "focus": false,
        "panel": "shared",
        "group": "ts",
        "showReuseMessage": false,
        "clear": false
      }
    },
    {
      "label": "ts:clean",
      "type": "shell",
      "command": "devenv tasks run ts:clean",
      "problemMatcher": ["$tsc"],
      "presentation": {
        "focus": false,
        "panel": "shared",
        "group": "ts",
        "showReuseMessage": false,
        "clear": false
      }
    },
    {
      "label": "ts:clean:build-watch",
      "type": "shell",
      "command": "devenv tasks run ts:clean && devenv tasks run ts:build-watch",
      "problemMatcher": ["$tsc-watch"],
      "isBackground": true,
      "presentation": {
        "focus": false,
        "panel": "shared",
        "group": "ts",
        "showReuseMessage": false,
        "clear": false
      }
    },

    // ============================================================
    // lint
    // ============================================================
    {
      "label": "lint",
      "type": "shell",
      "command": "devenv tasks run lint:check",
      "problemMatcher": [],
      "presentation": {
        "focus": false,
        "panel": "shared",
        "group": "lint",
        "showReuseMessage": false,
        "clear": true
      }
    },
    {
      "label": "lint:fix",
      "type": "shell",
      "command": "devenv tasks run lint:fix",
      "problemMatcher": [],
      "presentation": {
        "focus": true,
        "panel": "shared",
        "group": "lint",
        "showReuseMessage": false,
        "clear": true
      }
    },

    // ============================================================
    // buck2 — Buck owns typecheck + dist for the authoritative packages
    // ============================================================
    {
      "label": "buck2:check",
      "type": "shell",
      "command": "devenv tasks run buck2:check",
      "problemMatcher": ["$tsc"],
      "presentation": {
        "focus": false,
        "panel": "shared",
        "group": "buck2",
        "showReuseMessage": false,
        "clear": false
      }
    },
    {
      "label": "buck2:typescript:materialize-dist",
      "type": "shell",
      "command": "devenv tasks run buck2:typescript:materialize-dist",
      "problemMatcher": [],
      "presentation": {
        "focus": false,
        "panel": "shared",
        "group": "buck2",
        "showReuseMessage": false,
        "clear": false
      }
    },

    // ============================================================
    // test — source-owned Vitest; Buck owns the declared test inputs, not execution
    // ============================================================
    {
      "label": "test",
      "type": "shell",
      "command": "devenv tasks run test:run",
      "problemMatcher": [],
      "presentation": {
        "focus": true,
        "panel": "shared",
        "group": "test",
        "showReuseMessage": false,
        "clear": true
      }
    },

    // ============================================================
    // misc
    // ============================================================
    {
      "label": "build",
      "type": "shell",
      "command": "devenv tasks run ts:build",
      "problemMatcher": ["$tsc"],
      "presentation": {
        "focus": true,
        "panel": "shared",
        "group": "misc",
        "showReuseMessage": false,
        "clear": false
      }
    },
    {
      "label": "clean",
      "type": "shell",
      "command": "devenv tasks run build:clean",
      "problemMatcher": [],
      "presentation": {
        "focus": false,
        "panel": "shared",
        "group": "misc",
        "showReuseMessage": false,
        "clear": false
      }
    },
    {
      "label": "check",
      "type": "shell",
      "command": "devenv tasks run check:quick",
      "problemMatcher": ["$tsc"],
      "presentation": {
        "focus": true,
        "panel": "shared",
        "group": "misc",
        "showReuseMessage": false,
        "clear": true
      }
    },
    {
      "label": "check:all",
      "type": "shell",
      "command": "devenv tasks run check:all",
      "problemMatcher": ["$tsc"],
      "presentation": {
        "focus": true,
        "panel": "shared",
        "group": "misc",
        "showReuseMessage": false,
        "clear": true
      }
    }
  ]
}
