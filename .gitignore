# General
.DS_Store
*.log
tmp
.context
.cache/
.codex/
.evergreen/

# Node.js
node_modules
.pnpm-store

# TypeScript
*.tsbuildinfo
dist

# Python
__pycache__/
*.pyc

# Rust workspace build state
/rust/target/

# Buck2 daemon and materialized build state
buck-out/
# Generated editor snapshots for all admitted package roots
/.editor-view/
/context/.editor-view/
/packages/.editor-view/
/packages/@overeng/effect-rpc-tanstack/.editor-view/
# Machine-local cache client wiring (devenv-generated from the fleet default in
# devenv.nix; hand-edited overrides stay local)
/.buckconfig.local
# Executor-local, Nix-realized Buck capability projection
/.buck2/capabilities/
/.buck2/capabilities
/.buck2/capabilities.candidate.*
/.buck2/capabilities.lock
/.buck2/capability-generations/
# Registered Nix GC roots retaining the installed capability generation
/.buck2/capability-gcroots/

# Direnv
repos/

# Devenv
.devenv/
.devenv.lock
devenv.local.nix
# TODO(devenv2): remove stub once devenv 2 fixes generated .devenv.flake.nix handling:
# https://github.com/cachix/devenv/issues/2392
/.devenv.flake.nix
result
# Anchored: `nix build` writes its extra output links at the repo root, and an unanchored
# `result-*` shadows source files such as `src/core/result-envelope.ts`.
/result-*
.pre-commit-config.yaml

# Storybook
storybook-static
.vercel

# Story gate — diff images from a failed screenshot assertion. Evidence for one
# run, never an artifact: baselines are derived from a git ref on demand and
# live under node_modules/.cache, so nothing the gate produces is committed.
.vitest-attachments

# Playwright
test-results
playwright-report
.last-run.json
blob-report
.playwright-cli
.playwright-mcp

/tasks
# Devenv generated / internal
/devenv-swift-git-hooks
.pnpm-home

devenv.local.*

# Deterministic plugin-injected oxlint config cache (written by nix/oxlint-with-plugins.nix)
.oxlint-with-plugins.*

# Agent-session MCP server config (e.g. coord/smalltalk); regenerated per session, not tracked
.mcp.json
